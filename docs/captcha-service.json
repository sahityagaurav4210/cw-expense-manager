                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "exception"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Api operation failed"
                                        },
                                        "details": {
                                            "type": "object",
                                            "properties": {
