        "/api/v1/captcha/generate": {
            "get": {
                "description": "This api generates the captcha on the fly and returns the relative uri of generated captcha and its captcha id. Click the **Try it out** button to view the actual response.",
                "operationId": "CaptchaController_handleGenerateCaptchaReq",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "It signifies a successful response from the server and returns the newly generated **captcha uri** and its **captcha id**. Please note that in production a code will come as a value to message property, please refer official documentation for interpretation of all codes.",
                        "content": {
                            "image/png": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Api operation was successful"
                                        },
                                        "details": {
                                            "type": "object",
                                            "properties": {
                                                "message": {
                                                    "type": "string",
                                                    "example": "Captcha generated successfully"
                                                },
                                                "details": {
                                                    "type": "object",
                                                    "properties": {
                                                        "captchaUri": {
                                                            "type": "string",
                                                            "example": "/captcha/1234567890"
                                                        },
                                                        "captchaId": {
                                                            "type": "string",
                                                            "example": 1234567890
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "clientInfo": {
                                            "type": "string",
                                            "example": "127.0.0.1"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "It signifies an error response from the server (usually a 500 status code). It usually occurs when there has something bad happened at server side's code.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "error"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Api operation has failed"
                                        },
                                        "details": {
                                            "type": "object",
                                            "properties": {
                                                "message": {
                                                    "type": "string",
                                                    "example": "Something bad has happened."
                                                }
                                            }
                                        },
                                        "clientInfo": {
                                            "type": "string",
                                            "example": "127.0.0.1"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "summary": "Generates a new captcha when requested",
                "tags": [
                    "Captcha Controller"
                ]
            }
        },
        "/api/v1/captcha/image/{captchaId}": {
            "get": {
                "description": "This api returns the captcha image as its response of the requested captcha id. Click the **Try it out** button to view its actual response. Please note that image will only be returned in case of successful image retrieval.",
                "operationId": "CaptchaController_handleGetCaptchaImgReq",
                "parameters": [
                    {
                        "name": "captchaId",
                        "required": true,
                        "in": "path",
                        "description": "Please specify the captcha id which has been given to you by captcha generate api.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "It signifies a successful response from the server and returns a captcha image of the specified captcha id.",
                        "content": {
                            "image/png": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "It signifies a 'bad request' response from the server. This api usually gives this type of response when either the specified **CaptchaId** is invalid or it has been expired.",
                        "content": {
