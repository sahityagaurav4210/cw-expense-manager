                                    "example": "Captcha Service v0.0.1 © 2025 Gaurav Sahitya. All rights reserved."
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Returns an internal server error response when the application information cannot be retrieved due to unexpected issues.",
